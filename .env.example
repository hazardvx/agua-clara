# ============================================================
# Agua Clara — Variables de Entorno
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA uses service_role en el frontend.
# ============================================================

# --- Supabase ---
# URL del proyecto Supabase (ej: https://xxxxx.supabase.co)
SUPABASE_URL=

# Clave pública (anon/publishable) — segura para el navegador
SUPABASE_PUBLISHABLE_KEY=

# --- WhatsApp ---
# Número del negocio con código de país (ej: 50760000000)
BUSINESS_WHATSAPP_NUMBER=

# --- WhatsApp Business API (pendiente de configuración) ---
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Yappy (pendiente de credenciales comerciales) ---
YAPPY_MERCHANT_ID=

# --- Pasarela de pagos (pendiente) ---
PAYMENT_PROVIDER_SECRET=

# --- Servidor ---
PORT=4173
